# Copy to .env for local development. .env itself is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql://soteria:soteria@localhost:5432/soteria
# For Supabase: Project -> Settings -> Database -> Connection string -> URI
# (Direct connection), with the real password substituted in, e.g.:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Verify the Plaid-Verification JWT on incoming webhooks. Leave false for
# local/sandbox dev, since Plaid can never reach localhost to send a real
# signed webhook — there's nothing to verify against. Enable once deployed
# somewhere Plaid can actually reach.
PLAID_WEBHOOK_VERIFICATION_ENABLED=false

# App-layer encryption key for secrets at rest (e.g. plaid_access_token).
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# How often celery beat re-fans-out whole-user insight generation.
INSIGHTS_GENERATION_INTERVAL_MINUTES=360

# OpenAI and other third-party secrets are added here once those
# integrations are implemented.
