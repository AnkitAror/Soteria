# Copy to .env for local development. .env itself is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql://soteria:soteria@localhost:5432/soteria
# For Supabase: Project -> Settings -> Database -> Connection string -> URI
# (Direct connection), with the real password substituted in, e.g.:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Plaid, OpenAI, and other third-party secrets are added here once those
# integrations are implemented — not part of this initial scaffold.
