# Copy to .env for local development. .env itself is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql://soteria:soteria@localhost:5432/soteria
# For Supabase: Project -> Settings -> Database -> Connection string -> URI
# (Transaction pooler, port 6543 -- not the 15-connection session pooler on
# 5432, and not the direct connection), with the real password substituted
# in, e.g.:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Verify the Plaid-Verification JWT on incoming webhooks. Leave false for
# local/sandbox dev, since Plaid can never reach localhost to send a real
# signed webhook — there's nothing to verify against. Enable once deployed
# somewhere Plaid can actually reach.
PLAID_WEBHOOK_VERIFICATION_ENABLED=false
# Public URL Plaid should POST webhooks to (e.g. an ngrok tunnel), ending in
# /plaid/webhook. Leave blank to skip webhooks entirely for local dev — no
# ITEM_LOGIN_REQUIRED relink detection or transaction-sync webhooks will
# fire, but everything else (manual sync, Link, etc.) still works.
PLAID_WEBHOOK_URL=

# App-layer encryption key for secrets at rest (e.g. plaid_access_token).
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# How often celery beat re-fans-out whole-user insight generation.
INSIGHTS_GENERATION_INTERVAL_MINUTES=360

# Supabase Auth — the frontend authenticates directly against Supabase and
# sends the resulting access token as a Bearer header; the API verifies it
# against the project's public JWKS (SUPABASE_URL + /auth/v1/.well-known/
# jwks.json — no separate secret needed). Both values: Supabase dashboard ->
# Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini — powers the spending chatbot: NL->SQL generation, intent
# classification, answer synthesis, and embeddings (chat/orchestration,
# chat/rag). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Daily request cap shown on the Chat page's usage indicator (chat/usage.py)
# -- this app can't read your real quota from Google, so it's a self-tracked
# approximation compared against this number. Defaults to 20 (the free-tier
# limit observed for this project); raise it if you enable billing.
GEMINI_DAILY_REQUEST_LIMIT=20
